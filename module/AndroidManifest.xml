<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.glmkit.proxy"
    android:versionCode="62"
    android:versionName="1.0.62">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <queries>
        <package android:name="com.zhipuai.qingyan" />
    </queries>

    <application
        android:label="GLMKit"
        android:description="@string/moddesc"
        android:forceQueryable="true"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <meta-data android:name="xposedmodule" android:value="true" />
        <meta-data android:name="xposedminversion" android:value="93" />
        <meta-data android:name="xposeddescription" android:value="GLM (智谱清言) 本地 API 反代增强模块" />

        <activity
            android:name="com.glmkit.probe.SettingsActivity"
            android:exported="true"
            android:label="GLMKit"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name="com.glmkit.probe.LocalApiKeepAliveActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="glmkit-module"
                    android:host="local-api-keepalive" />
            </intent-filter>
        </activity>

        <service
            android:name="com.glmkit.probe.LocalApiKeepAliveService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:stopWithTask="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps the user-enabled GLM localhost API and SSE stream responsive in the background." />
        </service>

        <provider
            android:name="com.glmkit.probe.XposedActivationProvider"
            android:authorities="com.glmkit.proxy.XposedService"
            android:exported="true"
            android:grantUriPermissions="false" />

        <receiver
            android:name="com.glmkit.probe.XposedActivationReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="com.glmkit.proxy.HOOK_STARTED" />
                <action android:name="com.glmkit.proxy.HOOK_SUCCESS" />
                <action android:name="com.glmkit.proxy.AUTH_CAPTURED" />
                <action android:name="com.glmkit.proxy.GATEWAY_STARTED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
